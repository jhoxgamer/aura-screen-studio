{
  "name": "aura-screen-studio",
  "version": "2.2.0",
  "type": "module",
  "description": "Aura Screen Studio - Professional Screen, Webcam & Audio Recorder with Instant Global Video Sharing",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "test:ui": "node -e \"const { spawn } = require('child_process'); const p = spawn('node_modules/electron/dist/electron.exe', ['scripts/test-ui-runner.cjs'], { stdio: 'inherit' }); p.on('exit', c => process.exit(c));\"",
    "test:qa": "node scripts/run-all-qa.cjs",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "start": "electron dist-electron/main.js",
    "dist:win": "electron-builder --win --x64"
  },
  "keywords": [
    "aura",
    "screen-recorder",
    "webcam-bubble",
    "video-sharing",
    "electron",
    "react",
    "typescript"
  ],
  "author": "Aura Screen Studio",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.aurascreen.studio",
    "productName": "Aura Screen Studio",
    "copyright": "Copyright © 2026 Aura Screen Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/cloudflared.exe",
        "to": "cloudflared.exe"
      },
      {
        "from": "public/assets/application-icons/app-icon-tray.ico",
        "to": "app-icon-tray.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/application-icons/app-logo.ico"
    },
    "nsis": {
      "artifactName": "Aura-Screen-Studio-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura Screen Studio",
      "installerIcon": "public/assets/application-icons/app-logo.ico",
      "uninstallerIcon": "public/assets/application-icons/app-logo.ico",
      "uninstallDisplayName": "Aura Screen Studio",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "jhoxgamer",
      "repo": "aura-screen-studio"
    }
  }
}
